/* pages/quiz/quiz.wxss */

.container { background: var(--bg); min-height: 100vh; }

/* 过滤栏 */
.filter-bar {
  background: #fff;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}
.filter-scroll { white-space: nowrap; }
.filter-list { display: inline-flex; padding: 0 24rpx; gap: 16rpx; }
.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg);
  white-space: nowrap;
  transition: all 0.2s;
}
.filter-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.quiz-fine-filter {
  background: #fff;
  padding-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}
.filter-scroll-sub .filter-item {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
}

/* 刷题区域 */
.quiz-wrap { padding: 32rpx 24rpx; }

/* 进度 */
.quiz-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.progress-text { font-size: 26rpx; color: var(--text-secondary); }
.ai-batch-tip {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: -8rpx 0 20rpx;
  line-height: 1.5;
}
.progress-dots { display: flex; gap: 8rpx; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border);
}
.dot.done { background: var(--success); }
.dot.current { background: var(--primary); width: 24rpx; border-radius: 6rpx; }

.quiz-timer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: var(--radius);
  border: 2rpx solid var(--border);
}
.quiz-timer-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex: 1;
  margin-right: 16rpx;
}
.quiz-timer-value {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
}
.quiz-timer-value.urgent {
  color: var(--danger);
}

/* 题目卡片 */
.question-card { }
.question-meta { margin-bottom: 20rpx; }
.question-text { font-size: 30rpx; line-height: 1.8; color: var(--text-primary); }
.multi-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--accent, #f5a623);
  line-height: 1.5;
}

/* 选项 */
.options-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; }
.option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 28rpx 28rpx;
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}
.option-item.selected { border-color: var(--primary); background: rgba(26,31,94,0.05); }
.option-item.correct { border-color: var(--success); background: rgba(7,193,96,0.08); }
.option-item.wrong { border-color: var(--danger); background: rgba(238,10,36,0.06); }

.option-key {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  flex-shrink: 0;
}
.option-item.correct .option-key { background: var(--success); color: #fff; }
.option-item.wrong .option-key { background: var(--danger); color: #fff; }

.option-text { flex: 1; font-size: 28rpx; color: var(--text-primary); line-height: 1.5; }
.option-check { font-size: 32rpx; }
.option-item.correct .option-check { color: var(--success); }
.option-item.wrong .option-check { color: var(--danger); }

/* 申论主观题作答区 */
.essay-answer-card {
  margin-top: 24rpx;
  padding: 28rpx;
}
.essay-answer-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.essay-char-meta {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 14rpx;
}
.essay-char-meta-rest { color: var(--text-secondary); }
.essay-char-warn { color: var(--danger); font-weight: 600; }
.essay-char-ok { color: var(--success); font-weight: 600; }
.essay-grade-anchor {
  width: 100%;
  height: 1rpx;
}
.essay-textarea {
  width: 100%;
  min-height: 320rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--text-primary);
  background: var(--bg);
  border-radius: var(--radius);
  border: 2rpx solid var(--border);
}
.essay-answered-scroll {
  max-height: 480rpx;
  width: 100%;
}
.essay-answered-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}
.explanation-header-essay {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}
.expl-essay-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 解析 */
.explanation-card { }
.explanation-header { display: flex; align-items: center; justify-content: space-between; }
.expl-result { font-size: 28rpx; font-weight: 700; }
.expl-result.correct { color: var(--success); }
.expl-result.wrong { color: var(--danger); }
.expl-answer { font-size: 26rpx; color: var(--text-secondary); }
.expl-title { display: block; font-size: 28rpx; font-weight: 600; color: var(--primary); margin-bottom: 12rpx; }
.expl-content { font-size: 26rpx; color: var(--text-secondary); line-height: 1.8; }

/* 题号跳转 */
.quiz-nav-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.quiz-nav-row .btn-nav {
  flex: 1;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
}

/* 操作按钮 */
.quiz-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 32rpx;
}
.quiz-actions .btn-outline, .quiz-actions .btn-primary {
  flex: 1;
  padding: 28rpx;
}
.quiz-actions .btn-primary.full { flex: 2; }

/* 完成页 */
.finish-card {
  margin: 80rpx 24rpx;
  text-align: center;
  padding: 64rpx 40rpx;
}
.finish-emoji { display: block; font-size: 80rpx; margin-bottom: 24rpx; }
.finish-title { display: block; font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 48rpx; }
.finish-stats { display: flex; justify-content: center; gap: 60rpx; }
.finish-stat { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.finish-val { font-size: 48rpx; font-weight: 700; color: var(--primary); }
.finish-val.correct-color { color: var(--success); }
.finish-val.accent-color { color: var(--accent); }
.finish-key { font-size: 24rpx; color: var(--text-secondary); }

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: quiz-spin 0.8s linear infinite;
}
.loading-spinner.essay-spinner {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 0;
  margin-right: 20rpx;
  flex-shrink: 0;
}
@keyframes quiz-spin {
  to { transform: rotate(360deg); }
}

.essay-grading-card {
  margin-top: 20rpx;
  padding: 28rpx;
}
.essay-grading-row {
  display: flex;
  align-items: center;
}
.essay-grading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  flex: 1;
}

.essay-dim-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.essay-dim-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.essay-dim-item:last-child {
  border-bottom: none;
}
.essay-dim-head {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.essay-dim-body {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.55;
}
.essay-dim-improve {
  margin-top: 10rpx;
  padding-left: 8rpx;
}
.essay-dim-improve-line {
  display: block;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}
.essay-weak-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.essay-weak-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.essay-weak-item:last-child { border-bottom: none; }
.essay-weak-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(26, 31, 94, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.essay-weak-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.55;
}

.quiz-actions .btn-primary[disabled] {
  opacity: 0.65;
}

.quiz-empty {
  margin: 48rpx 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}
.quiz-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.quiz-empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}
