<!-- 学员信息录入页面 -->
<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <view class="header-logo">
      <image class="logo-icon" src="/images/logo.png" mode="aspectFit" />
      <text class="header-title">学员信息采集</text>
    </view>
    <text class="header-desc">完善信息，智能推荐最适合的岗位</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 基本信息 -->
    <view class="form-group">
      <view class="group-title">
        <text class="group-icon">📋</text>
        <text>基本信息</text>
      </view>

      <!-- 姓名 -->
      <view class="input-item">
        <text class="input-label">姓名 <text class="required">*</text></text>
        <input class="input-field" placeholder="请输入学员姓名" value="{{name}}" bindinput="onInput" data-field="name" />
      </view>

      <!-- 手机号 -->
      <view class="input-item">
        <text class="input-label">手机号 <text class="required">*</text></text>
        <input class="input-field" type="number" maxlength="11" placeholder="请输入手机号码" value="{{phone}}" bindinput="onInput" data-field="phone" />
        <view class="input-hint phone-hint">
          <text class="hint-icon">ℹ️</text>
          <text>学习记录与收藏按此号码在云端存档。更换手机号后，新号将视为新账号；如需合并旧号下的数据，请联系客服微信协助处理。</text>
        </view>
      </view>

      <!-- 年龄 -->
      <view class="input-item">
        <text class="input-label">年龄 <text class="required">*</text></text>
        <input class="input-field" type="number" placeholder="请输入年龄" value="{{age}}" bindinput="onInput" data-field="age" />
      </view>

      <!-- 性别 -->
      <view class="input-item">
        <text class="input-label">性别 <text class="required">*</text></text>
        <view class="radio-group">
          <view class="radio-item {{gender === '男' ? 'active' : ''}}" bindtap="onSelectGender" data-gender="男">
            <text class="radio-icon">👨</text>
            <text>男</text>
          </view>
          <view class="radio-item {{gender === '女' ? 'active' : ''}}" bindtap="onSelectGender" data-gender="女">
            <text class="radio-icon">👩</text>
            <text>女</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 教育背景 -->
    <view class="form-group">
      <view class="group-title">
        <text class="group-icon">🎓</text>
        <text>教育背景</text>
      </view>

      <!-- 学历 -->
      <view class="input-item">
        <text class="input-label">学历层次 <text class="required">*</text></text>
        <view class="select-group">
          <view class="select-item {{education === '专科' ? 'active' : ''}}" bindtap="onSelectEducation" data-edu="专科">
            <text>专科</text>
          </view>
          <view class="select-item {{education === '本科' ? 'active' : ''}}" bindtap="onSelectEducation" data-edu="本科">
            <text>本科</text>
          </view>
          <view class="select-item {{education === '硕士' ? 'active' : ''}}" bindtap="onSelectEducation" data-edu="硕士">
            <text>硕士</text>
          </view>
          <view class="select-item {{education === '博士' ? 'active' : ''}}" bindtap="onSelectEducation" data-edu="博士">
            <text>博士</text>
          </view>
        </view>
      </view>

      <!-- 毕业院校 -->
      <view class="input-item">
        <text class="input-label">毕业/在读院校</text>
        <input class="input-field" placeholder="请输入学校名称" value="{{school}}" bindinput="onInput" data-field="school" />
      </view>

      <!-- 专业 -->
      <view class="input-item">
        <text class="input-label">所学专业 <text class="required">*</text></text>
        <input class="input-field" placeholder="请输入专业名称，如：计算机、法学" value="{{major}}" bindinput="onInput" data-field="major" />
        <view class="input-hint">
          <text class="hint-icon">💡</text>
          <text>建议填写精确专业名，如"软件工程"而非"计算机类"</text>
        </view>
      </view>
    </view>

    <!-- 考试类型 -->
    <view class="form-group">
      <view class="group-title">
        <text class="group-icon">📝</text>
        <text>意向考试</text>
      </view>

      <!-- 考试类别 -->
      <view class="input-item">
        <text class="input-label">选择考试类型</text>
        <view class="select-group exam-type">
          <view class="select-item {{examType === '国考' ? 'active' : ''}}" bindtap="onSelectExamType" data-type="国考">
            <text>国考</text>
            <text class="select-desc">国家公务员考试</text>
          </view>
          <view class="select-item {{examType === '省考' ? 'active' : ''}}" bindtap="onSelectExamType" data-type="省考">
            <text>省考</text>
            <text class="select-desc">各省份公务员考试</text>
          </view>
          <view class="select-item {{examType === '两者都' ? 'active' : ''}}" bindtap="onSelectExamType" data-type="两者都">
            <text>两者都</text>
            <text class="select-desc">国考省考都考虑</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="onSubmit" loading="{{loading}}">
      <text class="btn-icon">🚀</text>
      <text>智能推荐岗位</text>
    </button>
    <view class="submit-hint">
      <text>点击即表示同意</text>
      <text class="link" bindtap="showPrivacy">《隐私保护政策》</text>
    </view>
  </view>

  <!-- 历史记录入口 -->
  <view class="history-section" wx:if="{{hasHistory}}">
    <view class="history-item" bindtap="goToHistory">
      <text class="history-icon">📜</text>
      <text>最近档案与切换</text>
      <text class="history-arrow">›</text>
    </view>
    <text class="history-hint">选择一条设为当前，用于收藏与学习统计的手机号同步。</text>
  </view>
</view>
