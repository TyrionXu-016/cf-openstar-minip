/* 学员信息页面样式 */
page {
  background: linear-gradient(180deg, #f8faff 0%, #e8f0fe 100%);
  min-height: 100vh;
}

.container {
  padding: 0 30rpx 120rpx;
}

/* 顶部标题 */
.header {
  padding: 40rpx 20rpx;
  text-align: center;
}

.header-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.logo-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1f5e;
}

.header-desc {
  font-size: 26rpx;
  color: #666;
}

/* 表单区域 */
.form-section {
  margin-bottom: 40rpx;
}

.form-group {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 31, 94, 0.08);
}

.group-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f5e;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f2f8;
}

.group-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 输入项 */
.input-item {
  margin-bottom: 30rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4757;
}

.input-field {
  background: #f8f9ff;
  border: 2rpx solid #e8ecf4;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #333;
  transition: all 0.3s;
}

.input-field:focus {
  border-color: #1a1f5e;
  background: #fff;
}

.input-hint {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
}

.hint-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.input-hint text {
  font-size: 24rpx;
  color: #5584e8;
}

/* 手机号说明：略区分于专业填写提示 */
.input-hint.phone-hint {
  background: #f7f5ff;
  align-items: flex-start;
}
.input-hint.phone-hint text:last-child {
  flex: 1;
  color: #5c5c7a;
  line-height: 1.55;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 24rpx;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #f8f9ff;
  border: 2rpx solid #e8ecf4;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.radio-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: transparent;
  color: #fff;
}

.radio-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 学历选择组 */
.select-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.select-group.exam-type {
  flex-direction: column;
  gap: 20rpx;
}

.select-item {
  padding: 20rpx 32rpx;
  background: #f8f9ff;
  border: 2rpx solid #e8ecf4;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.select-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.select-desc {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 提交按钮 */
.submit-section {
  padding: 0 20rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
}

.submit-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.submit-hint {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.link {
  color: #5584e8;
}

/* 历史记录 */
.history-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.history-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.history-item text:nth-child(2) {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.history-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.history-hint {
  display: block;
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}
