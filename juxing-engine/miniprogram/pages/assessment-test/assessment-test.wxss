@import "../quiz/quiz.wxss";

.container {
  background: var(--bg);
  min-height: 100vh;
}

.assess-banner {
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  padding: 20rpx 24rpx;
  position: relative;
  z-index: 0;
}

.quiz-wrap {
  position: relative;
  z-index: 1;
}
.assess-banner-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.finish-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 24rpx;
  padding: 0 16rpx;
  line-height: 1.6;
}

.plan-card {
  margin-top: 28rpx;
  text-align: left;
}
.plan-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.plan-card-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}
.plan-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}
.plan-item:first-of-type {
  border-top: none;
  padding-top: 0;
}
.plan-item-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 10rpx;
}
.plan-item-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.65;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text-secondary);
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  margin-bottom: 24rpx;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
