<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部 Hero 区域 -->
  <view class="hero gradient-bg" style="padding-top: {{navTopRpx}}rpx;">
    <view class="hero-inner">
      <view class="hero-top" style="padding-right: {{capsuleRightRpx}}rpx;">
        <view class="brand">
          <text class="brand-icon">⭐</text>
          <text class="brand-name">聚星引擎</text>
        </view>
        <view class="hero-date">{{currentDate}}</view>
      </view>

      <view class="hero-greeting">
        <text class="greeting-text">{{greetingText}}，{{userName}} 👋</text>
        <text class="greeting-sub">今日已学习 {{todayQuestions}} 题，继续加油！</text>
      </view>

      <!-- 学习进度条 -->
      <view class="progress-wrap">
        <view class="progress-label">
          <text>今日目标：{{dailyGoal}} 题</text>
          <text>{{todayQuestions}}/{{dailyGoal}}</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progressWidth}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="goal-reminder-banner" wx:if="{{showGoalReminderBanner}}">
    <view class="goal-reminder-main" bindtap="goQuiz">
      <text class="goal-reminder-text">今日目标 {{dailyGoal}} 题，还差 {{goalReminderShortfall}} 题，去刷题</text>
      <text class="goal-reminder-go">›</text>
    </view>
    <view class="goal-reminder-close" catchtap="dismissGoalReminderBanner">✕</view>
  </view>

  <!-- 统计卡片行 -->
  <view class="stats-row">
    <view class="stat-card" wx:for="{{stats}}" wx:key="key">
      <text class="stat-icon">{{item.icon}}</text>
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- AI 功能入口 -->
  <view class="section-title">
    <text class="title-text">AI 智能功能</text>
    <text class="title-badge">NEW</text>
  </view>
  <view class="ai-features">
    <view class="ai-card ai-card-blue" bindtap="goGenerate">
      <view class="ai-card-left">
        <text class="ai-icon">🤖</text>
        <view>
          <text class="ai-title">AI 智能出题</text>
          <text class="ai-desc">按知识点定制题目</text>
        </view>
      </view>
      <text class="ai-arrow">›</text>
    </view>

    <view class="ai-card ai-card-gold" bindtap="goEssay">
      <view class="ai-card-left">
        <text class="ai-icon">✍️</text>
        <view>
          <text class="ai-title">申论 AI 批改</text>
          <text class="ai-desc">秒出评分+详细反馈</text>
        </view>
      </view>
      <text class="ai-arrow">›</text>
    </view>

    <view class="ai-card ai-card-purple" bindtap="goChat">
      <view class="ai-card-left">
        <text class="ai-icon">💬</text>
        <view>
          <text class="ai-title">智能答疑</text>
          <text class="ai-desc">7×24h AI 解题助手</text>
        </view>
      </view>
      <text class="ai-arrow">›</text>
    </view>

    <view class="ai-card ai-card-green" bindtap="goOCR">
      <view class="ai-card-left">
        <text class="ai-icon">📷</text>
        <view>
          <text class="ai-title">拍题识别</text>
          <text class="ai-desc">拍照即可搜题解析</text>
        </view>
      </view>
      <text class="ai-arrow">›</text>
    </view>

    <view class="ai-card ai-card-red" bindtap="goAssessment">
      <view class="ai-card-left">
        <text class="ai-icon">🎯</text>
        <view>
          <text class="ai-title">学员测评 & 选岗</text>
          <text class="ai-desc">录入信息，智能推荐岗位</text>
        </view>
      </view>
      <text class="ai-arrow">›</text>
    </view>
  </view>

  <!-- 题库分类：行测 / 公基 / 申论五大题型模块（点模块可先选小知识点） -->
  <view class="section-title">
    <text class="title-text">题库分类</text>
    <text class="more-text" bindtap="goQuiz">全部 ›</text>
  </view>

  <view class="bank-block">
    <view class="bank-block-head">
      <text class="bank-block-tag bank-block-tag-xc">行测</text>
      <view class="bank-block-head-text">
        <text class="bank-block-title">知识模块</text>
        <text class="bank-block-desc">点模块可先选小知识点，再进入刷题</text>
      </view>
    </view>
    <view class="category-grid">
      <view
        class="category-item"
        wx:for="{{xingceBankCategories}}"
        wx:key="id"
        bindtap="openBankKnowledge"
        data-bank-id="{{item.id}}"
        data-bank-name="{{item.name}}"
      >
        <view class="category-icon-wrap" style="background: {{item.bgColor}}">
          <view class="category-icon">{{item.icon}}</view>
        </view>
        <view class="category-name">{{item.name}}</view>
        <view class="category-count">{{item.count}}题</view>
      </view>
    </view>
  </view>

  <view class="bank-block bank-block-spaced">
    <view class="bank-block-head">
      <text class="bank-block-tag bank-block-tag-gj">公基</text>
      <view class="bank-block-head-text">
        <text class="bank-block-title">知识模块</text>
        <text class="bank-block-desc">点模块可先选小知识点，再进入刷题</text>
      </view>
    </view>
    <view class="category-grid">
      <view
        class="category-item"
        wx:for="{{gongjiBankCategories}}"
        wx:key="id"
        bindtap="openBankKnowledge"
        data-bank-id="{{item.id}}"
        data-bank-name="{{item.name}}"
      >
        <view class="category-icon-wrap" style="background: {{item.bgColor}}">
          <view class="category-icon">{{item.icon}}</view>
        </view>
        <view class="category-name">{{item.name}}</view>
        <view class="category-count">{{item.count}}题</view>
      </view>
    </view>
  </view>

  <view class="bank-block bank-block-spaced">
    <view class="bank-block-head">
      <text class="bank-block-tag bank-block-tag-sl">申论</text>
      <view class="bank-block-head-text">
        <text class="bank-block-title">申论模块</text>
        <text class="bank-block-desc">点模块可先选小知识点，再进入刷题</text>
      </view>
    </view>
    <view class="category-grid category-grid-shenlun">
      <view
        class="category-item"
        wx:for="{{shenlunBankCategories}}"
        wx:key="id"
        bindtap="openBankKnowledge"
        data-bank-id="{{item.id}}"
        data-bank-name="{{item.name}}"
      >
        <view class="category-icon-wrap" style="background: {{item.bgColor}}">
          <view class="category-icon">{{item.icon}}</view>
        </view>
        <view class="category-name">{{item.name}}</view>
        <view class="category-count">{{item.count}}题</view>
      </view>
    </view>
  </view>

  <!-- 每日推荐错题 -->
  <view class="section-title">
    <text class="title-text">今日推荐练习</text>
  </view>
  <view class="recommend-card card" wx:if="{{recommendQuestion}}">
    <view class="recommend-tag">
      <text class="tag tag-blue">{{recommendQuestion.subject}}</text>
      <text class="tag tag-gold" style="margin-left:12rpx">{{recommendQuestion.difficulty}}</text>
    </view>
    <text class="recommend-question">{{recommendQuestion.question}}</text>
    <button class="btn-primary" style="margin-top:24rpx" bindtap="goQuiz">开始练习</button>
  </view>

  <view class="safe-bottom"></view>

  <!-- 知识模块 → 小知识点（与刷题页 taxonomy 一致） -->
  <view class="kp-modal-mask" wx:if="{{kpModalVisible}}">
    <view class="kp-modal-mask-bg" bindtap="closeKpModal"></view>
    <view class="kp-modal-sheet" catchtap="noop">
      <view class="kp-modal-handle"></view>
      <text class="kp-modal-title">{{kpModalTitle}}</text>
      <scroll-view scroll-y class="kp-modal-scroll" enable-flex>
        <view
          class="kp-modal-chip kp-modal-chip-all"
          bindtap="confirmKpModal"
          data-action="all"
        >不限 · 本模块全部题目</view>
        <view
          class="kp-modal-chip"
          wx:for="{{kpModalSubs}}"
          wx:for-index="kpIdx"
          wx:key="value"
          bindtap="confirmKpModal"
          data-action="kp"
          data-kp-index="{{kpIdx}}"
        >{{item.label}}</view>
      </scroll-view>
      <view class="kp-modal-footer">
        <text class="kp-modal-cancel" bindtap="closeKpModal">取消</text>
      </view>
    </view>
  </view>
</view>
