/* pages/index/index.wxss */

.container { background: var(--bg); min-height: 100vh; }

/* Hero */
.hero {
  padding: 0;
  border-radius: 0 0 40rpx 40rpx;
}
.hero-inner { padding: 32rpx 40rpx 48rpx; }
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.brand { display: flex; align-items: center; gap: 12rpx; }
.brand-icon { font-size: 40rpx; }
.brand-name { color: #fff; font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-date { color: rgba(255,255,255,0.7); font-size: 24rpx; }

.greeting-text { display: block; color: #fff; font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.greeting-sub { display: block; color: rgba(255,255,255,0.75); font-size: 26rpx; margin-bottom: 32rpx; }

.progress-wrap { }
.progress-label {
  display: flex;
  justify-content: space-between;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.progress-bar {
  height: 12rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 10rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.goal-reminder-banner {
  display: flex;
  align-items: stretch;
  margin: 0 24rpx 20rpx;
  background: linear-gradient(90deg, #fff7e6 0%, #fff2d9 100%);
  border: 1rpx solid rgba(250, 173, 20, 0.45);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(250, 173, 20, 0.12);
  overflow: hidden;
  position: relative;
  z-index: 8;
}
.goal-reminder-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  min-width: 0;
}
.goal-reminder-text {
  flex: 1;
  font-size: 26rpx;
  color: #8a5a18;
  line-height: 1.45;
}
.goal-reminder-go {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #d48806;
  font-weight: 600;
}
.goal-reminder-close {
  flex-shrink: 0;
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #bfbfbf;
  border-left: 1rpx solid rgba(0, 0, 0, 0.06);
  background: rgba(255, 255, 255, 0.35);
}

/* 统计行 */
.stats-row {
  display: flex;
  margin: -32rpx 24rpx 0;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  padding: 32rpx 0;
  position: relative;
  z-index: 10;
}
.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border-right: 1rpx solid var(--border);
}
.stat-card:last-child { border-right: none; }
.stat-icon { font-size: 32rpx; }
.stat-value { font-size: 34rpx; font-weight: 700; color: var(--primary); }
.stat-label { font-size: 22rpx; color: var(--text-secondary); }

/* Section标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 40rpx 20rpx;
}
.title-text { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.title-badge {
  font-size: 20rpx;
  font-weight: 600;
  background: var(--accent);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.more-text { margin-left: auto; font-size: 26rpx; color: var(--text-secondary); }

/* AI 功能卡片 */
.ai-features { padding: 0 24rpx; display: flex; flex-direction: column; gap: 20rpx; }
.ai-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: var(--radius-lg);
}
.ai-card-left { display: flex; align-items: center; gap: 24rpx; }
.ai-icon { font-size: 48rpx; }
.ai-title { display: block; font-size: 30rpx; font-weight: 600; }
.ai-desc { display: block; font-size: 24rpx; margin-top: 4rpx; opacity: 0.75; }
.ai-arrow { font-size: 48rpx; opacity: 0.5; }

.ai-card-blue { background: linear-gradient(135deg, #e8eaf6 0%, #c5cae9 100%); color: var(--primary); }
.ai-card-gold { background: linear-gradient(135deg, #fff8e1 0%, #ffe082 100%); color: #c77700; }
.ai-card-purple { background: linear-gradient(135deg, #ede7f6 0%, #ce93d8 100%); color: #6a1b9a; }
.ai-card-green { background: linear-gradient(135deg, #e8f5e9 0%, #a5d6a7 100%); color: #2e7d32; }
.ai-card-red { background: linear-gradient(135deg, #fce4ec 0%, #f48fb1 100%); color: #c62828; }

/* 题库分类 */
.bank-block {
  padding: 0 24rpx;
}
.bank-block-spaced {
  margin-top: 28rpx;
}
.bank-block-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.bank-block-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  color: #fff;
}
.bank-block-tag-xc {
  background: linear-gradient(135deg, #3949ab 0%, #1a237e 100%);
}
.bank-block-tag-sl {
  background: linear-gradient(135deg, #e65100 0%, #bf360c 100%);
}
.bank-block-tag-gj {
  background: linear-gradient(135deg, #00897b 0%, #004d40 100%);
}
.bank-block-head-text {
  flex: 1;
  min-width: 0;
}
.bank-block-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.bank-block-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  line-height: 1.45;
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}
.category-grid-shenlun {
  grid-template-columns: repeat(3, 1fr);
  max-width: 100%;
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border-radius: var(--radius);
  padding: 28rpx 16rpx;
  box-shadow: var(--shadow);
}
.category-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.category-icon {
  font-size: 40rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.category-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.35;
}
.category-count { font-size: 22rpx; color: var(--text-hint); line-height: 1.3; }

/* 推荐卡片 */
.recommend-card { margin: 0 24rpx; }
.recommend-tag { margin-bottom: 20rpx; }
.recommend-question { font-size: 28rpx; color: var(--text-primary); line-height: 1.7; }

/* 首页：知识模块 → 小知识点底部弹层 */
.kp-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.kp-modal-mask-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.kp-modal-sheet {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 72vh;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
}
.kp-modal-handle {
  width: 72rpx;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 8rpx;
  margin: 8rpx auto 20rpx;
}
.kp-modal-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  text-align: center;
}
.kp-modal-scroll {
  max-height: 52vh;
  margin-bottom: 16rpx;
}
.kp-modal-chip {
  display: block;
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius);
  background: rgba(26, 31, 94, 0.06);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid rgba(26, 31, 94, 0.08);
}
.kp-modal-chip-all {
  font-weight: 600;
  background: rgba(26, 31, 94, 0.1);
  color: var(--primary);
}
.kp-modal-footer {
  text-align: center;
  padding-top: 8rpx;
}
.kp-modal-cancel {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 16rpx 32rpx;
}
