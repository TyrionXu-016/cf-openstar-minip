<view class="container">
  <view class="card row">
    <view class="label-wrap">
      <text class="label">云端失败时静默降级</text>
      <text class="hint">关闭后，AI 答疑等云能力失败会弹出提示</text>
    </view>
    <switch checked="{{quietCloudFallback}}" bindchange="onQuietChange" color="#1a1f5e" />
  </view>

  <view class="card row">
    <view class="label-wrap">
      <text class="label">每日学习目标提醒</text>
      <text class="hint">订阅消息与推送能力规划中</text>
    </view>
    <switch checked="{{dailyGoalReminder}}" bindchange="onDailyReminderChange" color="#1a1f5e" />
  </view>

  <view class="card row link-row" bindtap="showPrivacyPolicy">
    <view class="label-wrap">
      <text class="label">隐私保护政策</text>
      <text class="hint">查看个人信息采集范围、用途与保护方式</text>
    </view>
    <text class="link-arrow">›</text>
  </view>
</view>
