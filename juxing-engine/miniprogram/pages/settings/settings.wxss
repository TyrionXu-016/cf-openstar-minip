.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.link-row {
  cursor: pointer;
}

.label-wrap {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
}

.link-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-hint);
}
