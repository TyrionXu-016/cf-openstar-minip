/* 智能选岗页面样式 */
page {
  background: linear-gradient(180deg, #f8faff 0%, #e8f0fe 100%);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.container {
  padding: 30rpx;
}

/* 学员信息卡片 */
.student-card {
  background: linear-gradient(135deg, #1a1f5e 0%, #3d4f8a 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(26, 31, 94, 0.2);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.student-tags {
  display: flex;
  gap: 12rpx;
}

.student-tags .tag {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.match-score {
  text-align: center;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
}

.score-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffd700;
}

.score-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.detail-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 结果区域 */
.result-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f5e;
}

.result-count {
  font-size: 24rpx;
  color: #666;
}

/* 岗位列表 */
.position-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.position-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}

.position-card:active {
  transform: scale(0.98);
}

.position-card.high {
  border-left: 6rpx solid #52c41a;
}

.position-card.medium {
  border-left: 6rpx solid #faad14;
}

.position-card.low {
  border-left: 6rpx solid #d9d9d9;
}

.position-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.position-main {
  flex: 1;
}

.position-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f5e;
  margin-bottom: 10rpx;
}

.position-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.position-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.tag-category {
  background: #e8f0fe;
  color: #1a1f5e;
}

.tag-level {
  background: #f6ffed;
  color: #52c41a;
}

.tag-hard {
  background: #fff2e8;
  color: #fa8c16;
}

.match-badge {
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.match-badge.high {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
}

.match-badge.medium {
  background: linear-gradient(135deg, #faad14, #ffc53d);
  color: #fff;
}

.match-badge.low {
  background: #f5f5f5;
  color: #999;
}

.position-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.position-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.feature-tag {
  background: #f0f5ff;
  color: #5584e8;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.position-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.salary, .promotion {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.salary-icon, .promotion-icon {
  margin-right: 6rpx;
}

/* 底部功能栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f5f7ff;
  margin: 0 8rpx;
}

.bar-btn.primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.bar-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.bar-btn text:last-child {
  font-size: 24rpx;
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
  align-items: flex-end;
}

.detail-modal.show {
  display: flex;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1f5e;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 60vh;
}

.detail-section {
  margin-bottom: 30rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1f5e;
  margin-bottom: 12rpx;
}

.detail-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

.requirement-item {
  margin-bottom: 10rpx;
}

.req-label {
  font-size: 26rpx;
  color: #666;
}

.req-value {
  font-size: 26rpx;
  color: #333;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-tag {
  background: #e8f0fe;
  color: #1a1f5e;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  background: #f5f7ff;
  color: #1a1f5e;
}

.modal-btn::after {
  border: none;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}
