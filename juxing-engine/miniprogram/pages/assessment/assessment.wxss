.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 60rpx 40rpx 40rpx;
  color: #fff;
}

.back {
  font-size: 36rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.content {
  padding: 30rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-title .icon {
  font-size: 36rpx;
}

.input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.input:last-child {
  margin-bottom: 0;
}

.count-options {
  display: flex;
  gap: 20rpx;
}

.count-option {
  flex: 1;
  padding: 30rpx 20rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.count-option.active {
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
}

.count-option .number {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}

.count-option.active .number {
  color: #667eea;
}

.count-option .label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.difficulty-options {
  display: flex;
  gap: 20rpx;
}

.difficulty-option {
  flex: 1;
  padding: 30rpx 16rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.difficulty-option.active {
  border-color: #43e97b;
  background: linear-gradient(135deg, rgba(67, 233, 123, 0.1), rgba(56, 249, 215, 0.1));
}

.difficulty-option .icon-text {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.difficulty-option .name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.difficulty-option .desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.start-btn {
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, #1a1a2e, #0f3460);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(26, 26, 46, 0.3);
  margin-top: 20rpx;
}

.start-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 36rpx;
}
