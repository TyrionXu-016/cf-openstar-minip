/* pages/profile/profile.wxss */

.container { background: var(--bg); min-height: 100vh; }

/* 用户区 */
.profile-hero {
  padding-left: 32rpx;
  padding-bottom: 64rpx;
  padding-right: 32rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.user-card { display: flex; align-items: center; gap: 28rpx; }
.user-avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
}
.avatar-img { width: 100%; height: 100%; }
.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 40rpx;
  background: rgba(0,0,0,0.4);
  text-align: center;
  font-size: 20rpx;
}
.user-info { display: flex; flex-direction: column; gap: 8rpx; }
.user-name { color: #fff; font-size: 36rpx; font-weight: 700; }
.user-level { color: rgba(255,255,255,0.8); font-size: 24rpx; }

.editor-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}
.editor-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}
.editor-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.editor-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.avatar-picker {
  margin-top: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: #fff;
  color: var(--text-primary);
  font-size: 26rpx;
}
.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}
.nickname-input {
  margin-top: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.nickname-placeholder {
  color: var(--text-hint);
}
.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.editor-actions .btn-outline,
.editor-actions .btn-primary {
  flex: 1;
}

/* 统计卡片 */
.stats-card { margin: -32rpx 24rpx 0; padding: 32rpx; }
.stats-title { display: block; font-size: 28rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 28rpx; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-val { font-size: 36rpx; font-weight: 800; color: var(--primary); }
.stat-name { font-size: 22rpx; color: var(--text-secondary); text-align: center; }

/* 菜单 */
.menu-section {
  background: #fff;
  border-radius: var(--radius-lg);
  margin: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
  cursor: pointer;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.menu-count { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.menu-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 20rpx;
}
.menu-arrow { font-size: 32rpx; color: var(--text-hint); }

/* 版本 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.version-line { font-size: 22rpx; color: var(--text-hint); }
