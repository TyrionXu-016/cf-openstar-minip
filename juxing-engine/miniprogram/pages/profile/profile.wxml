<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户卡片 -->
  <view class="profile-hero gradient-bg">
    <view class="user-card">
      <view class="user-avatar" bindtap="getUserInfo">
        <image src="{{userInfo.avatar || '/miniprogram/images/default_avatar.png'}}" class="avatar-img" mode="aspectFill"></image>
        <view class="avatar-edit">✏️</view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '点击授权登录'}}</text>
        <text class="user-level">⭐ 学习达人</text>
      </view>
    </view>
  </view>

  <!-- 学习数据 -->
  <view class="stats-card card">
    <text class="stats-title">📊 学习数据概览</text>
    <view class="stats-grid">
      <view class="stat-item" wx:for="{{stats}}" wx:key="key">
        <text class="stat-val">{{item.value}}</text>
        <text class="stat-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goAssessment">
      <text class="menu-icon">🎯</text>
      <text class="menu-text">学员测评</text>
      <text class="menu-badge">新功能</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goWrongList">
      <text class="menu-icon">📕</text>
      <text class="menu-text">错题本</text>
      <text class="menu-count tag tag-red" wx:if="{{wrongCount > 0}}">{{wrongCount}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEssayHistory">
      <text class="menu-icon">📝</text>
      <text class="menu-text">申论记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text class="menu-icon">⭐</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAIGallery">
      <text class="menu-icon">🤖</text>
      <text class="menu-text">AI 出题记录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">学习设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>聚星引擎 v1.0.0</text>
    <text>Powered by AI · 腾讯混元</text>
  </view>

  <view class="safe-bottom"></view>
</view>
