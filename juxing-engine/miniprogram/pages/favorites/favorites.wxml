<view class="container">
  <view class="phone-bar phone-bar-row" wx:if="{{studentPhone}}">
    <text class="phone-bar-text">当前学习账号：{{studentPhone}}</text>
    <text class="phone-bar-action" wx:if="{{hasArchiveHistory}}" bindtap="goArchiveSwitch">切换档案</text>
  </view>
  <view class="phone-bar warn" wx:if="{{showPhoneHint}}">
    <text class="phone-bar-text">未识别到手机号，收藏仅保存在本机。请到学员信息填写手机号以便与云端同步。</text>
  </view>

  <view class="card" wx:if="{{loading}}">
    <text class="empty-text">正在加载收藏岗位...</text>
  </view>

  <view class="empty card" wx:elif="{{list.length === 0}}">
    <block wx:if="{{emptyReason === 'need_phone'}}">
      <text class="empty-title">需要先填写手机号</text>
      <text class="empty-text">学员信息里的手机号用于云端同步收藏与学习统计。填写后即可从服务端拉取收藏列表。</text>
      <button class="btn-primary" bindtap="goStudentInfo">去填写学员信息</button>
      <button class="btn-outline retry-btn" bindtap="loadFavorites">重新检测</button>
    </block>
    <block wx:elif="{{emptyReason === 'need_backend'}}">
      <text class="empty-title">未连接云端服务</text>
      <text class="empty-text">当前未配置后端地址（如 app.js 中的 backendBaseUrl）。配置并重新编译后，可在此同步收藏。</text>
      <button class="btn-primary" bindtap="loadFavorites">重新检测</button>
    </block>
    <block wx:else>
      <text class="empty-title">暂无收藏岗位</text>
      <text class="empty-text">在「智能选岗推荐」中点击「收藏岗位」即可保存到这里。</text>
      <button class="btn-primary" bindtap="loadFavorites">重新加载</button>
    </block>
  </view>

  <scroll-view scroll-y class="scroll" wx:else>
    <view class="card item" wx:for="{{list}}" wx:key="id">
      <view class="item-head">
        <text class="tag tag-blue">{{item.category || '岗位'}}</text>
        <text class="tag tag-gold">{{item.matchScore ? (item.matchScore + '%匹配') : '收藏'}}</text>
      </view>
      <text class="q-preview">{{item.name}}</text>
      <text class="q-preview" style="font-size: 24rpx; color: #8a93b2; margin-top: 8rpx;">{{item.description}}</text>
      <view class="item-actions">
        <button class="btn-outline sm" size="mini" data-id="{{item.id}}" bindtap="openPosition">查看推荐</button>
        <button class="btn-outline sm danger" size="mini" data-id="{{item.id}}" bindtap="removeItem">取消收藏</button>
      </view>
    </view>
  </scroll-view>
</view>
