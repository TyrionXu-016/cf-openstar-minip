.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.scroll {
  max-height: calc(100vh - 48rpx);
}

.empty {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.item {
  margin-bottom: 24rpx;
}
.item-head {
  margin-bottom: 16rpx;
}
.q-preview {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.item-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.btn-outline.sm {
  flex: 1;
  padding: 16rpx;
  font-size: 24rpx;
}
.btn-outline.danger {
  color: var(--danger);
  border-color: var(--danger);
}
