.wrap {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f7fa;
}

.hint {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #5c5c7a;
  line-height: 1.55;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 31, 94, 0.06);
}

.scroll {
  max-height: calc(100vh - 200rpx);
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 31, 94, 0.08);
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f5e;
}

.phone {
  font-size: 28rpx;
  color: #2d3494;
  font-weight: 500;
}

.row {
  display: block;
  font-size: 24rpx;
  color: #8a93b2;
  line-height: 1.5;
}

.time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #aaa;
}

.btn-use {
  margin-top: 24rpx;
  width: 100%;
  background: linear-gradient(90deg, #1a1f5e 0%, #2d3494 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #8a93b2;
  margin-bottom: 32rpx;
}

.btn-primary {
  background: linear-gradient(90deg, #1a1f5e 0%, #2d3494 100%);
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
}
