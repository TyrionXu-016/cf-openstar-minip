/* pages/essay-result/essay-result.wxss */

.container { background: var(--bg); min-height: 100vh; }

.topic-brief {
  margin: 24rpx 24rpx 0;
}
.topic-brief-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.topic-brief-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

/* 总分区 */
.score-hero { border-radius: 0 0 48rpx 48rpx; padding: 48rpx 40rpx 64rpx; }
.score-hero-inner { display: flex; flex-direction: column; align-items: center; }
.score-label { color: rgba(255,255,255,0.8); font-size: 26rpx; margin-bottom: 24rpx; }
.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 6rpx solid rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 24rpx;
}
.score-number { font-size: 80rpx; font-weight: 900; color: #fff; line-height: 1; }
.score-unit { font-size: 28rpx; color: rgba(255,255,255,0.8); align-self: flex-end; padding-bottom: 16rpx; }

.score-grade-badge {
  background: var(--accent);
  color: #fff;
  padding: 10rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.score-feedback {
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}

/* 卡片通用 */
.card { margin: 0 24rpx 24rpx; padding: 32rpx; }
.card-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 24rpx; }

/* 维度 */
.dimension-card { margin-top: 24rpx; }
.dim-row { margin-bottom: 32rpx; }
.dim-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.dim-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.dim-score { font-size: 26rpx; font-weight: 700; color: var(--primary); }
.dim-bar-wrap { height: 12rpx; background: var(--border); border-radius: 10rpx; margin-bottom: 12rpx; overflow: hidden; }
.dim-bar { height: 100%; background: linear-gradient(90deg, var(--primary), #4a54b8); border-radius: 10rpx; }
.dim-feedback { display: block; font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; margin-bottom: 8rpx; }
.dim-improvements { display: flex; flex-direction: column; gap: 6rpx; }
.improve-item { font-size: 22rpx; color: var(--accent); line-height: 1.5; }

/* 优缺点 */
.strength-weak-row { display: flex; gap: 20rpx; margin: 0 24rpx 24rpx; }
.sw-card { flex: 1; margin: 0; }
.sw-title { display: block; font-size: 26rpx; font-weight: 700; margin-bottom: 16rpx; }
.sw-title.strength { color: var(--success); }
.sw-title.weakness { color: var(--warning); }
.sw-item { display: block; font-size: 24rpx; color: var(--text-secondary); line-height: 1.7; }

/* 遗漏要点 */
.missed-list { display: flex; flex-direction: column; gap: 12rpx; }
.missed-item { display: flex; gap: 12rpx; }
.missed-icon { font-size: 28rpx; color: var(--danger); flex-shrink: 0; }
.missed-text { font-size: 26rpx; color: var(--text-primary); line-height: 1.6; }

/* 作文 */
.answer-header { display: flex; align-items: center; justify-content: space-between; }
.toggle-text { font-size: 26rpx; color: var(--primary); }
.answer-text { display: block; font-size: 26rpx; color: var(--text-secondary); line-height: 1.9; margin-top: 16rpx; }

/* 操作 */
.result-actions { padding: 0 24rpx; display: flex; flex-direction: column; gap: 20rpx; }
.result-actions .btn-primary, .result-actions .btn-outline { padding: 30rpx; }

.ai-generated-mark {
  margin: 16rpx 24rpx 0;
  padding: 8rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(0, 0, 0, 0.42);
  background: transparent;
}
