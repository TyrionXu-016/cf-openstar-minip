/* pages/ai-chat/ai-chat.wxss */

.container { background: var(--bg); display: flex; flex-direction: column; height: 100vh; }

/* 顶部 */
.chat-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx 20rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.chat-header .ai-avatar {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.header-info { flex: 1; }
.header-name { display: block; color: #fff; font-size: 32rpx; font-weight: 700; margin-bottom: 6rpx; }
.header-status { display: block; color: rgba(255,255,255,0.75); font-size: 22rpx; }
.header-clear { color: rgba(255,255,255,0.7); font-size: 26rpx; }

/* 消息区域 */
.chat-scroll { flex: 1; overflow-y: auto; }
.chat-messages { padding: 24rpx; }

/* 消息气泡 */
.message-wrap {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.user-wrap { flex-direction: row-reverse; }

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.ai-avatar-sm { background: var(--primary); color: #fff; }
.user-avatar-sm { background: var(--accent); color: #fff; }

.message {
  max-width: 72%;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.ai-message {
  background: #fff;
  color: var(--text-primary);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow);
}
.user-message {
  background: var(--primary);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.msg-br { display: block; height: 0; }

/* 输入中动画 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 32rpx;
}
.typing-indicator .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--text-hint);
  animation: typing 1.4s infinite;
}
.typing-indicator .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing {
  0%, 80%, 100% { transform: scale(1); opacity: 0.4; }
  40% { transform: scale(1.3); opacity: 1; }
}

/* 快捷问题 */
.quick-questions { background: #fff; padding: 20rpx 0; white-space: nowrap; border-top: 1rpx solid var(--border); }
.quick-list { display: inline-flex; gap: 16rpx; padding: 0 24rpx; }
.quick-item {
  display: inline-block;
  padding: 14rpx 24rpx;
  background: rgba(26,31,94,0.08);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--primary);
  white-space: nowrap;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
}
.chat-input {
  flex: 1;
  background: var(--bg);
  border-radius: 50rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}
.send-btn {
  width: 100rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--border);
  color: var(--text-hint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s;
}
.send-btn.active {
  background: var(--primary);
  color: #fff;
}

.ai-generated-mark {
  padding: 12rpx 24rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(0, 0, 0, 0.42);
  background: #fff;
}

.chat-foot-spacer {
  background: #fff;
}
