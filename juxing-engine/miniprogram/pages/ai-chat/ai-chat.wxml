<!--pages/ai-chat/ai-chat.wxml-->
<view class="container">
  <!-- 顶部 -->
  <view class="chat-header gradient-bg" style="padding-top: {{chatHeaderTopRpx}}rpx; padding-right: {{chatHeaderRightRpx}}rpx;">
    <view class="ai-avatar">🤖</view>
    <view class="header-info">
      <text class="header-name">聚星AI助手</text>
      <text class="header-status">● 在线 · 专注公考答疑</text>
    </view>
    <view class="header-clear" bindtap="clearChat">清空</view>
  </view>
  <view class="ai-generated-mark">本服务为人工智能生成内容（AI生成），结果仅供参考</view>

  <!-- 消息列表 -->
  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
  >
    <view class="chat-messages">
      <!-- 欢迎消息 -->
      <view class="message-wrap ai-wrap">
        <view class="avatar ai-avatar-sm">🤖</view>
        <view class="message ai-message">
          <text>你好！我是聚星AI助手 ⭐</text>
          <text class="msg-br"></text>
          <text>专注公考答疑，可以帮你解答：</text>
          <text class="msg-br"></text>
          <text>• 行测各类题型解题技巧</text>
          <text class="msg-br"></text>
          <text>• 申论写作方法与框架</text>
          <text class="msg-br"></text>
          <text>• 备考规划与学习方法</text>
          <text class="msg-br"></text>
          <text>• 公基知识点梳理</text>
          <text class="msg-br"></text>
          <text>有什么问题，尽管问我！😊</text>
        </view>
      </view>

      <!-- 动态消息 -->
      <view
        class="message-wrap {{item.role === 'user' ? 'user-wrap' : 'ai-wrap'}}"
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
      >
        <view class="avatar ai-avatar-sm" wx:if="{{item.role === 'assistant'}}">🤖</view>
        <view class="message {{item.role === 'user' ? 'user-message' : 'ai-message'}}">
          <text>{{item.content}}</text>
        </view>
        <view class="avatar user-avatar-sm" wx:if="{{item.role === 'user'}}">我</view>
      </view>

      <!-- 输入中动画 -->
      <view class="message-wrap ai-wrap" wx:if="{{typing}}">
        <view class="avatar ai-avatar-sm">🤖</view>
        <view class="message ai-message typing-indicator">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>

      <view id="chat-bottom" style="height: 20rpx;"></view>
    </view>
  </scroll-view>

  <!-- 快捷问题 -->
  <scroll-view scroll-x class="quick-questions" wx:if="{{messages.length === 0}}">
    <view class="quick-list">
      <view
        class="quick-item"
        wx:for="{{quickQuestions}}"
        wx:key="index"
        bindtap="sendQuickQuestion"
        data-q="{{item}}"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input
      class="chat-input"
      placeholder="问我任何公考问题..."
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      confirm-type="send"
      adjust-position="{{false}}"
    />
    <view class="send-btn {{inputText ? 'active' : ''}}" bindtap="sendMessage">
      <text>发送</text>
    </view>
  </view>
  <view style="height: env(safe-area-inset-bottom); padding-bottom: 20rpx;"></view>
</view>
