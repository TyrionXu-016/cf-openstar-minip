.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx;
}

.scroll {
  max-height: calc(100vh - 48rpx);
}

.empty {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.item {
  margin-bottom: 24rpx;
}
.item-meta {
  margin-bottom: 12rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.score {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 600;
}
.time {
  font-size: 24rpx;
  color: var(--text-secondary);
}
