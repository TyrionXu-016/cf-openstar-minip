/* app.wxss - 全局样式 */

/* 品牌色彩系统 */
page {
  --primary: #1a1f5e;       /* 深蓝主色 */
  --primary-light: #2d3494;  /* 浅蓝 */
  --accent: #f5a623;         /* 金色强调 */
  --accent-light: #ffd88a;   /* 浅金 */
  --success: #07c160;
  --danger: #ee0a24;
  --warning: #ff976a;
  --bg: #f5f7fa;
  --card-bg: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #666888;
  --text-hint: #aaaacc;
  --border: #e8eaf6;
  --radius: 16rpx;
  --radius-lg: 24rpx;
  --shadow: 0 4rpx 24rpx rgba(26, 31, 94, 0.08);
  --shadow-lg: 0 8rpx 40rpx rgba(26, 31, 94, 0.14);
  
  background-color: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 渐变背景 */
.gradient-bg {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 60%, #4a54b8 100%);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 31, 94, 0.3);
  border: none;
}

.btn-accent {
  background: linear-gradient(90deg, #f5a623 0%, #f7b84b 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.3);
  border: none;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border-radius: 50rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--primary);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-blue { background: rgba(26, 31, 94, 0.1); color: var(--primary); }
.tag-purple { background: rgba(99, 102, 241, 0.12); color: #4f46e5; }
.tag-gold { background: rgba(245, 166, 35, 0.15); color: #c88000; }
.tag-green { background: rgba(7, 193, 96, 0.1); color: #07c160; }
.tag-red { background: rgba(238, 10, 36, 0.1); color: #ee0a24; }
.tag-gray { background: rgba(0, 0, 0, 0.06); color: var(--text-secondary); }

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 加载态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-hint);
  font-size: 26rpx;
}

/* 安全底部 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  padding-bottom: 32rpx;
}

/* 文字截断 */
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
